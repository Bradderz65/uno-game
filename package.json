{
  "name": "uno-multiplayer",
  "version": "2.0.0",
  "description": "Multiplayer UNO game with local network play",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"nodemon server/index.js\" \"vite\"",
    "start": "node server/index.js",
    "build": "vite build",
    "preview": "npm run build && node server/index.js --dist",
    "test": "node --test test/"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.11",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
